APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
HTTP_VERIFY_SSL=true

ASAAS_WEBHOOK_TOKEN=
ONDAPAY_WEBHOOK_SECRET=

WHATSAPP_HTTP_TOKEN=
WHATSAPP_SOCKET_SECRET=
WHATSAPP_INTERNAL_URL=http://127.0.0.1:3200
WHATSAPP_AUTH_DIR=/var/lib/toolzapp/whatsapp-auth
WHATSAPP_SEND_INTERVAL_MS=6000
WHATSAPP_SEND_QUEUE_MAX=50
WHATSAPP_MAX_MEDIA_BYTES=26214400
WHATSAPP_JID_CACHE_TTL_MS=300000

ZAPI_BASE_URL=https://api.z-api.io
ZAPI_CLIENT_TOKEN=

# ComprarSMS (SMS sem dependência de aparelho conectado)
# Use o token do painel; se deixar vazio, a integração usa email/senha para
# obter um JWT temporário pelo endpoint /api-authenticate.
COMPRARSMS_API_URL=https://xlwblpjbcovfxlcbeiqs.supabase.co/functions/v1
COMPRARSMS_API_TOKEN=
COMPRARSMS_API_EMAIL=
COMPRARSMS_API_PASSWORD=
COMPRARSMS_WEBHOOK_SECRET=
COMPRARSMS_TIMEOUT=45
COMPRARSMS_CONNECT_TIMEOUT=10
COMPRARSMS_BATCH_SIZE=500
COMPRARSMS_BATCH_DELAY_SECONDS=15

# Infobip SMS API v3
INFOBIP_API_URL=https://api.infobip.com
INFOBIP_API_KEY=
INFOBIP_SENDER=
INFOBIP_WEBHOOK_SECRET=
INFOBIP_TIMEOUT=45
INFOBIP_CONNECT_TIMEOUT=10
# Documentação: até 50.000 destinos por requisição. A fila usa 500 por padrão.
INFOBIP_MAX_DESTINATIONS_PER_REQUEST=50000
# Até 5 partes concatenadas por SMS para controlar custo e entregabilidade.
INFOBIP_MAX_SEGMENTS=5

# Provedor usado por novas filas SMS. As campanhas existentes preservam o seu provedor.
SMS_PROVIDER=infobip
SMS_BATCH_SIZE=500
SMS_BATCH_DELAY_SECONDS=15
SMS_STATUS_POLL_HOURS=48
