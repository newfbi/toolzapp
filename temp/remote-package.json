{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "binance-integration",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "packageManager": "yarn@1.22.19",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "build:crypto": "tsc -p tsconfig.botoperations.crypto.json --noEmit false",
        "postbuild:crypto": "node scripts/ensure-botoperationsjs-package.cjs",
        "build:mt5": "tsc -p tsconfig.botoperations.mt5.json --noEmit false",
        "postbuild:mt5": "node scripts/ensure-botoperationsjs-package.cjs",
        "watch:mt5": "tsc -p tsconfig.botoperations.mt5.json --noEmit false --watch",
        "validate:mt5": "tsc -p tsconfig.botoperations.mt5.json --noEmit && yarn test:mt5",
        "build:bitget": "yarn build:crypto",
        "postbuild:bitget": "node scripts/ensure-botoperationsjs-package.cjs",
        "watch:bitget": "tsc -p tsconfig.botoperations.crypto.json --noEmit false --watch",
        "validate:crypto": "tsc -p tsconfig.botoperations.crypto.json --noEmit && yarn test:crypto",
        "server:crypto": "node resources/js/BotOperationsJs/Crypto/server.js",
        "server:bitget": "node resources/js/BotOperationsJs/Crypto/server.js",
        "server:mt5": "node scripts/start-mt5-bridge-service.cjs",
        "dev:server": "yarn build:crypto && node resources/js/BotOperationsJs/Crypto/server.js",
        "dev:server:crypto": "yarn build:crypto && node resources/js/BotOperationsJs/Crypto/server.js",
        "queue:consumer": "node resources/js/BotOperationsJs/Crypto/workers/queueConsumer.js",
        "queue:dev": "yarn build:crypto && node resources/js/BotOperationsJs/Crypto/workers/queueConsumer.js",
        "queue:dev:crypto": "yarn build:crypto && node resources/js/BotOperationsJs/Crypto/workers/queueConsumer.js",
        "mt5:bridge": "node scripts/start-mt5-bridge-service.cjs",
        "mt5:build-and-start": "yarn build:mt5 && node scripts/pm2-start.cjs mt5",
        "mt5:start": "yarn build:mt5 && node scripts/pm2-start.cjs mt5",
        "crypto:start": "yarn build:crypto && node scripts/pm2-start.cjs crypto",
        "crypto:pm2": "node scripts/pm2-start.cjs crypto",
        "crypto:stop": "pm2 stop crypto-api-server crypto-queue-consumer crypto-trading-requeue-failed",
        "crypto:logs": "pm2 logs crypto-api-server crypto-queue-consumer crypto-trading-requeue-failed",
        "pm2:start": "node scripts/pm2-start.cjs all",
        "pm2:start:all": "node scripts/pm2-start.cjs all",
        "pm2:start:crypto": "node scripts/pm2-start.cjs crypto",
        "pm2:start:mt5": "node scripts/pm2-start.cjs mt5",
        "pm2:stop": "pm2 stop crypto-api-server crypto-queue-consumer crypto-trading-requeue-failed mt5-mql-bridge mt5-bridge-reconciler mt5-linux-xvfb",
        "pm2:restart": "pm2 restart ecosystem.config.cjs",
        "pm2:logs": "pm2 logs crypto-api-server crypto-queue-consumer crypto-trading-requeue-failed mt5-mql-bridge mt5-bridge-reconciler",
        "pm2:kill": "node scripts/pm2-kill.cjs",
        "bitget:start": "node scripts/start-bitget-no-pm2.cjs crypto",
        "bitget:build-and-start": "yarn crypto:start",
        "test": "yarn validate:botops && yarn test:botops",
        "test:botops": "node scripts/run-botoperations-tests.cjs",
        "test:crypto": "node scripts/run-botoperations-tests.cjs crypto",
        "test:mt5": "node scripts/run-botoperations-tests.cjs mt5",
        "test:jest": "jest --config jest.config.cjs --runInBand",
        "validate:botops:build": "tsc -p tsconfig.json --noEmit",
        "validate:botops:source": "tsc -p tsconfig.botoperations.source.json --noEmit",
        "validate:botops": "yarn validate:botops:build && yarn validate:botops:source",
        "get-candlesticks:mt5:prepare": "node resources/js/BotOperations/MT5/scripts/GetCandleSticks/prepareMt5TickExport.mjs",
        "get-candlesticks:mt5:history": "node resources/js/BotOperations/MT5/scripts/GetCandleSticks/runMt5TickHistory.mjs",
        "get-candlesticks:mt5:verify": "node resources/js/BotOperations/MT5/scripts/GetCandleSticks/verifyMt5TickCoverage.mjs",
        "get-candlesticks:install-mt5": "powershell -ExecutionPolicy Bypass -File resources/js/BotOperations/MT5/scripts/GetCandleSticks/InstallMt5GetCandleExporters.ps1",
        "backtest:margin": "tsx resources/js/BotOperations/Crypto/scripts/BackTestMargin/MarginBacktest.ts",
        "backtest:margin:mt5:60d:ticks": "tsx resources/js/BotOperations/MT5/scripts/BackTestMargin/MarginBacktest.ts exchange=mt5 preset=mt5 dataSource=mql5 mql5TicksPath=resources/js/BotOperations/MT5/scripts/GetCandleSticks/Data/GetCandleSticks_XAUUSD_ticks_60d.csv gran=1m days=60 bankroll=10000",
        "backtest:margin:mt5:60d:ticks:bank250": "tsx resources/js/BotOperations/MT5/scripts/BackTestMargin/MarginBacktest.ts exchange=mt5 preset=mt5 dataSource=mql5 mql5TicksPath=resources/js/BotOperations/MT5/scripts/GetCandleSticks/Data/GetCandleSticks_XAUUSD_ticks_60d.csv gran=1m days=60 bankroll=250",
        "backtest:margin:mt5:30d": "node resources/js/BotOperations/MT5/scripts/BackTestMargin/tools/RunMt5LiveBacktest.mjs",
        "backtest:margin:sweep": "tsx resources/js/BotOperations/Crypto/scripts/BackTestMargin/tools/RunBacktestSweep.ts",
        "backtest:marketking": "tsx resources/js/BotOperations/Crypto/scripts/BackTestMarketKing/MarketKingBacktest.ts",
        "backtest:marketking:mt5:30d": "node resources/js/BotOperations/MT5/scripts/BackTestMarketKing/tools/RunMt5LiveBacktest.mjs",
        "backtest:quantum": "tsx resources/js/BotOperations/Crypto/scripts/BackTestQuantum/QuantumBacktest.ts",
        "backtest:quantum:mt5:30d": "node resources/js/BotOperations/MT5/scripts/BackTestQuantum/tools/RunMt5LiveBacktest.mjs",
        "backtest:marketking:sweep": "tsx resources/js/BotOperations/Crypto/scripts/BackTestMarketKing/tools/RunBacktestSweep.ts",
        "backtest:mt5:bridge": "tsx resources/js/BotOperations/MT5/scripts/BackTestMargin/tools/RunMt5ForexBridge.ts fileBridgePollMs=25 fileBridgeStableMs=5",
        "lint": "echo \"No lint configured\""
    },
    "dependencies": {
        "@binance/common": "2.3.2",
        "axios": "^1.11.0",
        "cors": "^2.8.5",
        "crypto": "^1.0.1",
        "crypto-js": "^4.2.0",
        "dotenv": "^16.3.1",
        "dukascopy-node": "^1.46.4",
        "express": "^4.18.2",
        "json-with-bigint": "^3.4.4",
        "laravel-crypton": "^1.0.1",
        "mysql2": "^3.16.1",
        "node-rsa": "^1.1.1",
        "winston": "^3.11.0",
        "ws": "^8.16.0"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.14",
        "@types/node": "^20.10.0",
        "@types/node-rsa": "^1.1.4",
        "@types/ws": "^8.5.10",
        "autoprefixer": "^10.4.2",
        "concurrently": "^9.0.1",
        "eslint": "8.57.0",
        "jest": "^29.6.4",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.1.0",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.1",
        "tsdown": "^0.16.5",
        "tsx": "^4.20.6",
        "typedoc": "^0.28.5",
        "typedoc-plugin-markdown": "^4.0.0",
        "typedoc-plugin-pages": "^1.0.0",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.24.0",
        "vite": "^7.0.7"
    }
}
